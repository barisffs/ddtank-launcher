<Window x:Class="DDTankLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDTank Launcher"
        Width="800" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <!-- Ana Pencere İçeriği -->
    <Border Background="{StaticResource BackgroundGradientBrush}" 
            CornerRadius="15"
            BorderBrush="{StaticResource BackgroundLightBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Özel Başlık Çubuğu -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BackgroundDarkBrush}"
                    CornerRadius="15,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo ve Başlık -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        <TextBlock Text="🎮" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="DDTank Launcher" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Pencere Kontrol Butonları -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="─" 
                                Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Küçült"/>
                        <Button Content="✕" 
                                Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ana İçerik -->
            <Grid Grid.Row="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Başlık Bölümü -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,40">
                    <TextBlock Text="🏰 DDTank PvP" 
                               Style="{StaticResource TitleStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Private Server Launcher"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Sunucu Durumu -->
                <Border Grid.Row="1" 
                        Background="{StaticResource BackgroundDarkBrush}"
                        CornerRadius="10"
                        Padding="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="350">
                    <StackPanel>
                        <TextBlock Text="Sunucu Durumu"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="StatusIndicator"
                                     Width="12" Height="12"
                                     Fill="{StaticResource WarningYellowBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Kontrol ediliyor..."
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="ServerInfoText"
                                   Text="Sunucu: 127.0.0.1:9001"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        
                        <TextBlock x:Name="PingText"
                                   Text=""
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Oyunu Başlat Butonu -->
                <Button Grid.Row="2"
                        x:Name="PlayButton"
                        Content="🎮  OYUNU BAŞLAT"
                        Style="{StaticResource PlayButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,20"
                        Click="PlayButton_Click"/>

                <!-- Alt Menü -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Durum Kontrolü -->
                    <Button Grid.Column="0"
                            x:Name="RefreshButton"
                            Content="🔄  Durumu Kontrol Et"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="RefreshButton_Click"/>

                    <!-- Sağ: Ayarlar -->
                    <Button Grid.Column="2"
                            Content="⚙️  Ayarlar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="SettingsButton_Click"/>
                </Grid>
            </Grid>

            <!-- Yükleniyor Göstergesi -->
            <Border x:Name="LoadingOverlay"
                    Grid.Row="1"
                    Background="#AA000000"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText"
                               Text="Lütfen bekleyin..."
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="DDTankLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Width="500" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Border Background="{StaticResource BackgroundGradientBrush}" 
            CornerRadius="15"
            BorderBrush="{StaticResource BackgroundLightBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BackgroundDarkBrush}"
                    CornerRadius="15,15,0,0">
                <Grid>
                    <TextBlock Text="⚙️  Ayarlar" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    
                    <Button Content="✕" 
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Ayarlar Formu -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Margin="25,20">
                <StackPanel>
                    
                    <!-- Sunucu Ayarları -->
                    <TextBlock Text="🌐 Sunucu Ayarları"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    
                    <!-- Sunucu IP -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Sunucu IP Adresi" 
                                   Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="ServerIPTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="127.0.0.1"/>
                    </StackPanel>

                    <!-- Sunucu Port -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Sunucu Portu" 
                                   Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="ServerPortTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="9001"/>
                    </StackPanel>

                    <!-- Flash Ayarları -->
                    <TextBlock Text="🎬 Flash Ayarları"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,10,0,15"/>

                    <!-- SWF Dosyası -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="SWF Oyun Dosyası" 
                                   Style="{StaticResource FormLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SwfPathTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1"
                                    Content="📂"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Padding="15,8"
                                    Click="BrowseSwfButton_Click"
                                    ToolTip="SWF dosyası seç"/>
                        </Grid>
                    </StackPanel>

                    <!-- Flash Player Yolu -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Flash Player / Ruffle Yolu" 
                                   Style="{StaticResource FormLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FlashPlayerPathTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1"
                                    Content="📂"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Padding="15,8"
                                    Click="BrowseFlashPlayerButton_Click"
                                    ToolTip="Flash Player seç"/>
                        </Grid>
                        <TextBlock Text="💡 Ruffle veya Adobe Flash Player Projector kullanabilirsiniz."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Alt Butonlar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundDarkBrush}"
                    CornerRadius="0,0,15,15"
                    Padding="25,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Varsayılanlara Sıfırla -->
                    <Button Grid.Column="0"
                            Content="🔄  Varsayılanlar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ResetButton_Click"
                            ToolTip="Ayarları varsayılanlara sıfırla"/>

                    <!-- İptal -->
                    <Button Grid.Column="2"
                            Content="İptal"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"
                            Margin="0,0,10,0"/>

                    <!-- Kaydet -->
                    <Button Grid.Column="3"
                            Content="💾  Kaydet"
                            Style="{StaticResource PlayButtonStyle}"
                            FontSize="14"
                            Padding="25,10"
                            Click="SaveButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
